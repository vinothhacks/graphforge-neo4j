# =====================================================================
# graphforge configuration  (copy to .env and fill in — .env is gitignored)
# =====================================================================
# Every value below is read from the environment. Nothing is hardcoded.
# Only the section(s) you actually use need to be filled in.

# ---------------------------------------------------------------------
# Neo4j (required for any push to the graph)
# ---------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
# Target database. Community Edition only supports "neo4j".
NEO4J_DATABASE=neo4j

# How many statements per write transaction.
GF_BATCH_SIZE=500
# Store full source text as :Line nodes (heavy). true/false.
GF_INCLUDE_LINES=false

# ---------------------------------------------------------------------
# Git source (for `graphforge git`)
# ---------------------------------------------------------------------
# Local clone target directory.
GF_REPO_DIR=./repos
# Optional credentials for private HTTP(S) remotes.
GIT_USERNAME=
GIT_PASSWORD=
GIT_TOKEN=

# Optional: auto-discover repositories from a GitLab group.
GITLAB_SERVER=
GITLAB_GROUP_ID=
GITLAB_TOKEN=
GIT_DEFAULT_BRANCH=main

# History depth: number of commits to import per repo (0 = full history).
GF_HISTORY_LIMIT=0

# ---------------------------------------------------------------------
# Database source (for `graphforge db`)
# ---------------------------------------------------------------------
# engine: mysql | mssql | postgres
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Comma-separated list of databases/catalogs to import.
DB_NAMES=
# MS SQL Server only: ODBC driver name.
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# PostgreSQL only: default schema filter (comma-separated), blank = all non-system.
PG_SCHEMAS=public
