# ---- graphforge ----
# Secrets & local config (NEVER commit)
.env
*.env
!.env.example
# `*.env` above matches only names ENDING in .env, so the hardening pass's
# audit.env.empty was not covered by it. Scoped rather than `*.env.*`,
# which would re-ignore .env.example and defeat the negation above.
audit.env*
# Playwright MCP scratch output: snapshots, console logs, screenshots.
.playwright-mcp/
# Showcase video renders: audio, frames, recordings, generated images, the mp4.
scripts/showcase/out/
config/repositories.json
config/databases.json
config/connection.json

